+
+    #if canImport(Accelerate)
+    /// Nearest/linear mask resample through vImage.
+    ///
+    /// Masks are preview-only data; the full-resolution export path never uses
+    /// this function. `vImageScale_Planar8` removes the per-pixel Swift loop
+    /// from the slider hot path on 12 MP sources.
+    private static func scaleWithAccelerate(
+        _ mask: MaskBuffer,
+        to size: PixelSize
+    ) -> MaskBuffer? {
+        var destination = [UInt8](repeating: 0, count: size.width * size.height)
+        let error: vImage_Error = mask.bytes.withUnsafeBytes { sourceRaw in
+            destination.withUnsafeMutableBytes { destinationRaw in
+                guard let sourceBase = sourceRaw.baseAddress,
+                      let destinationBase = destinationRaw.baseAddress
+                else {
+                    return kvImageNullPointerArgument
+                }
+                var source = vImage_Buffer(
+                    data: UnsafeMutableRawPointer(mutating: sourceBase),
+                    height: vImagePixelCount(mask.height),
+                    width: vImagePixelCount(mask.width),
+                    rowBytes: mask.width
+                )
+                var target = vImage_Buffer(
+                    data: destinationBase,
+                    height: vImagePixelCount(size.height),
+                    width: vImagePixelCount(size.width),
+                    rowBytes: size.width
+                )
+                return vImageScale_Planar8(
+                    &source,
+                    &target,
+                    nil,
+                    vImage_Flags(kvImageHighQualityResampling)
+                )
+            }
+        }
+        guard error == kvImageNoError else {
+            return nil
+        }
+        return try? MaskBuffer(
+            width: size.width,
+            height: size.height,
+            bytes: Data(destination)
+        )
+    }
+    #endif
 }
