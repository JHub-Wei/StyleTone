+/// Immutable index buffer for one mesh grid.
+private struct GeometryIndexBuffer {
+    let buffer: MTLBuffer
+    let indexCount: Int
+}
+
+/// LRU cache for uploaded source textures.
+///
+/// The cache is bounded by bytes so a burst of 12 MP images cannot retain an
+/// unbounded amount of GPU memory. The key is the identity of the immutable
+/// `CGImage`, not its pixels.
+private final class GeometryTextureCache: @unchecked Sendable {
+    private let lock = NSLock()
+    private let costLimit: Int
+    private var entries: [ObjectIdentifier: (texture: MTLTexture, cost: Int, stamp: UInt64)] = [:]
+    private var clock: UInt64 = 0
+
+    init(costLimit: Int) {
+        self.costLimit = max(1, costLimit)
+    }
+
+    func texture(for key: ObjectIdentifier) -> MTLTexture? {
+        lock.lock()
+        defer { lock.unlock() }
+        guard var entry = entries[key] else { return nil }
+        clock &+= 1
+        entry.stamp = clock
+        entries[key] = entry
+        return entry.texture
+    }
+
+    func insert(_ texture: MTLTexture, for key: ObjectIdentifier) {
+        lock.lock()
+        defer { lock.unlock() }
+        clock &+= 1
+        let cost = texture.width * texture.height * 4
+        entries[key] = (texture, max(1, cost), clock)
+
+        var total = entries.values.reduce(0) { $0 + $1.cost }
+        while total > costLimit, entries.count > 1 {
+            guard let oldest = entries.min(by: { $0.value.stamp < $1.value.stamp }) else {
+                break
+            }
+            total -= oldest.value.cost
+            entries.removeValue(forKey: oldest.key)
+        }
+    }
+}
+
+/// Index buffers only depend on the grid dimensions and are immutable.
+private final class GeometryIndexBufferCache: @unchecked Sendable {
+    private struct Key: Hashable {
+        let width: Int
+        let height: Int
+    }
+
+    private let lock = NSLock()
+    private var entries: [Key: GeometryIndexBuffer] = [:]
+
+    func buffer(width: Int, height: Int) -> GeometryIndexBuffer? {
+        lock.lock()
+        defer { lock.unlock() }
+        return entries[Key(width: width, height: height)]
+    }
+
+    func insert(_ buffer: GeometryIndexBuffer, width: Int, height: Int) {
+        lock.lock()
+        defer { lock.unlock() }
+        entries[Key(width: width, height: height)] = buffer
+    }
+}
