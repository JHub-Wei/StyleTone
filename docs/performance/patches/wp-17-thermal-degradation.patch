diff --git a/Packages/StyleToneUI/Sources/StyleToneUI/Editor/EditorThermalPolicy.swift b/Packages/StyleToneUI/Sources/StyleToneUI/Editor/EditorThermalPolicy.swift
new file mode 100644
index 0000000..5071bcf
--- /dev/null
+++ b/Packages/StyleToneUI/Sources/StyleToneUI/Editor/EditorThermalPolicy.swift
@@ -0,0 +1,254 @@
+import Foundation
+
+#if canImport(Darwin)
+import Darwin
+#endif
+
+/// Thermal pressure mapped from `ProcessInfo.thermalState`.
+public enum EditorThermalPressure: String, Sendable, CaseIterable {
+    case nominal
+    case fair
+    case serious
+    case critical
+
+    var rank: Int {
+        switch self {
+        case .nominal: return 0
+        case .fair: return 1
+        case .serious: return 2
+        case .critical: return 3
+        }
+    }
+}
+
+/// Battery saver state.
+public enum EditorPowerReserve: String, Sendable {
+    case normal
+    case lowPower
+}
+
+/// Coarse hardware class for the preview degradation matrix.
+public enum EditorDeviceClass: String, Sendable, CaseIterable {
+    case reference
+    case lowEnd
+    case unknown
+}
+
+/// Reason a preview tier was reduced.
+public enum EditorDegradationReason: String, Sendable, CaseIterable {
+    case lowEndDevice
+    case lowPowerMode
+    case thermalFair
+    case thermalSerious
+    case thermalCritical
+    case adaptiveGovernor
+}
+
+/// Effective degradation for the editor, including the user-facing notice key.
+public struct EditorThermalDegradation: Sendable, Equatable {
+    public static let none = EditorThermalDegradation(
+        level: .full,
+        reasons: [],
+        allowsHighQualityRender: true,
+        showsExportWarning: false,
+        noticeKey: nil
+    )
+
+    public let level: EditorPerformanceLevel
+    public let reasons: [EditorDegradationReason]
+    public let allowsHighQualityRender: Bool
+    public let showsExportWarning: Bool
+    /// Localization key for the one-line notice; `nil` when nothing changed.
+    public let noticeKey: String?
+
+    public init(
+        level: EditorPerformanceLevel,
+        reasons: [EditorDegradationReason],
+        allowsHighQualityRender: Bool,
+        showsExportWarning: Bool,
+        noticeKey: String?
+    ) {
+        self.level = level
+        self.reasons = reasons
+        self.allowsHighQualityRender = allowsHighQualityRender
+        self.showsExportWarning = showsExportWarning
+        self.noticeKey = noticeKey
+    }
+
+    public var previewLongEdge: Int {
+        level.previewLongEdge
+    }
+
+    public var isDegraded: Bool {
+        level != .full
+    }
+}
+
+/// Production counterpart of WP-24's tested `ThermalPerformancePolicy`.
+///
+/// WP-24 cannot edit the UI module, so this file is delivered as a reviewable
+/// patch. The policy is intentionally identical to the tested reference in
+/// `Tests/Performance/Harness/Sources/PerformanceKit/ThermalPolicy.swift`.
+public struct EditorThermalPolicy: Sendable {
+    public init() {}
+
+    /// Resolves the effective preview level.
+    public func degradation(
+        thermal: EditorThermalPressure,
+        power: EditorPowerReserve,
+        deviceClass: EditorDeviceClass,
+        governorLevel: EditorPerformanceLevel
+    ) -> EditorThermalDegradation {
+        var reasons: [EditorDegradationReason] = []
+        var level = governorLevel
+        if governorLevel != .full {
+            reasons.append(.adaptiveGovernor)
+        }
+
+        if deviceClass == .lowEnd {
+            reasons.append(.lowEndDevice)
+            level = maxLevel(level, .reduced)
+        }
+
+        switch thermal {
+        case .nominal:
+            break
+        case .fair:
+            reasons.append(.thermalFair)
+            level = maxLevel(level, .reduced)
+        case .serious:
+            reasons.append(.thermalSerious)
+            level = maxLevel(level, .minimal)
+        case .critical:
+            reasons.append(.thermalCritical)
+            level = maxLevel(level, .minimal)
+        }
+
+        if power == .lowPower {
+            reasons.append(.lowPowerMode)
+            level = maxLevel(level, .reduced)
+        }
+
+        return EditorThermalDegradation(
+            level: level,
+            reasons: reasons,
+            allowsHighQualityRender: thermal != .critical,
+            showsExportWarning: thermal.rank >= EditorThermalPressure.serious.rank,
+            noticeKey: noticeKey(thermal: thermal, power: power, deviceClass: deviceClass)
+        )
+    }
+
+    /// Notice key for the most severe active state.
+    public func noticeKey(
+        thermal: EditorThermalPressure,
+        power: EditorPowerReserve,
+        deviceClass: EditorDeviceClass
+    ) -> String? {
+        switch thermal {
+        case .critical:
+            return "editor.performance.thermalCritical"
+        case .serious:
+            return "editor.performance.thermalSerious"
+        case .fair:
+            return power == .lowPower
+                ? "editor.performance.lowPower"
+                : "editor.performance.thermalFair"
+        case .nominal:
+            if power == .lowPower {
+                return "editor.performance.lowPower"
+            }
+            if deviceClass == .lowEnd {
+                return "editor.performance.lowEnd"
+            }
+            return nil
+        }
+    }
+
+    // MARK: - Current host state
+
+    public static func currentThermalPressure() -> EditorThermalPressure {
+        switch ProcessInfo.processInfo.thermalState {
+        case .nominal: return .nominal
+        case .fair: return .fair
+        case .serious: return .serious
+        case .critical: return .critical
+        @unknown default: return .fair
+        }
+    }
+
+    public static func currentPowerReserve() -> EditorPowerReserve {
+        ProcessInfo.processInfo.isLowPowerModeEnabled ? .lowPower : .normal
+    }
+
+    public static func currentDeviceClass() -> EditorDeviceClass {
+        #if canImport(Darwin)
+        var info = utsname()
+        guard uname(&info) == 0 else { return .unknown }
+        let model = withUnsafeBytes(of: &info.machine) { raw -> String in
+            guard let base = raw.baseAddress else { return "" }
+            return String(cString: base.assumingMemoryBound(to: CChar.self))
+        }
+        switch model {
+        case "iPhone14,5", "iPhone14,2", "iPhone14,3", "iPhone14,4":
+            return .reference
+        case "iPhone12,8", "iPhone14,6", "iPhone13,1", "iPhone12,1",
+             "iPhone12,3", "iPhone12,5", "iPhone11,2", "iPhone11,4",
+             "iPhone11,6", "iPhone11,8":
+            return .lowEnd
+        default:
+            return ProcessInfo.processInfo.physicalMemory < 3_500_000_000
+                ? .lowEnd
+                : .unknown
+        }
+        #else
+        return .unknown
+        #endif
+    }
+
+    // MARK: - Helpers
+
+    private func maxLevel(
+        _ lhs: EditorPerformanceLevel,
+        _ rhs: EditorPerformanceLevel
+    ) -> EditorPerformanceLevel {
+        rank(lhs) >= rank(rhs) ? lhs : rhs
+    }
+
+    private func rank(_ level: EditorPerformanceLevel) -> Int {
+        switch level {
+        case .full: return 0
+        case .reduced: return 1
+        case .minimal: return 2
+        }
+    }
+}
+
+/// Removes its process notifications when the view model is released.
+final class EditorThermalObserver: @unchecked Sendable {
+    private var tokens: [NSObjectProtocol] = []
+
+    init(onChange: @escaping @Sendable () -> Void) {
+        let center = NotificationCenter.default
+        tokens.append(
+            center.addObserver(
+                forName: ProcessInfo.thermalStateDidChangeNotification,
+                object: nil,
+                queue: .main
+            ) { _ in onChange() }
+        )
+        tokens.append(
+            center.addObserver(
+                forName: Notification.Name("NSProcessInfoPowerStateDidChange"),
+                object: nil,
+                queue: .main
+            ) { _ in onChange() }
+        )
+    }
+
+    deinit {
+        let center = NotificationCenter.default
+        for token in tokens {
+            center.removeObserver(token)
+        }
+    }
+}
